# LFG Traditions - our own tradition tree layouts (tree_template in common/tradition_categories). Vanilla's are top-level
# containerWindowTypes in interface/topbar_traditions_view.gui, looked up by name, so ours can live in this file instead
# of replacing that one (which UI Overhaul Dynamic and A Lot of Traditions both replace, keeping vanilla's positions).
# Each tradition slot is a 44x44 containerWindowType named <template>_tradition_<n>; slot n = the n-th entry of the
# category's `traditions` list.

guiTypes = {

	### Vortex (Tempest): five slots in a ring, each requiring the one before, arrows spiralling clockwise around an
	### empty eye. Three rows high, like vanilla's three-layer trees (rows at y 55 / 125 / 195).
	#
	#             ##### 
	#             # 1 #
	#        ↗    #####    ↘
	#   #####               #####
	#   # 5 #     (eye)     # 2 #
	#   #####               #####
	#        ↖  #####  #####  ↙
	#           # 4 # ← # 3 #
	#           #####  #####
	containerWindowType = {
		name = "tree_lfg_vortex"
		position = { x = 0 y = 0 }

		# art/make_tempest_art.py (positions there must match these)
		iconType = {
			name = "vortex_arrows"
			spriteType = "GFX_lfg_vortex_arrows"
			position = { x = 55 y = 45 }
			alwaysTransparent = yes
		}

		containerWindowType = {
			name = "tree_lfg_vortex_tradition_1"
			position = { x = 131 y = 53 }
		}

		containerWindowType = {
			name = "tree_lfg_vortex_tradition_2"
			position = { x = 199 y = 103 }
		}

		containerWindowType = {
			name = "tree_lfg_vortex_tradition_3"
			position = { x = 173 y = 183 }
		}

		containerWindowType = {
			name = "tree_lfg_vortex_tradition_4"
			position = { x = 89 y = 183 }
		}

		containerWindowType = {
			name = "tree_lfg_vortex_tradition_5"
			position = { x = 62 y = 103 }
		}
		# Don't put any container windows above this comment that shouldn't contain a tradition.
	}
}
