# The planetcraft's mid section: Gigastructural's weapon locators (war_planet_locators_mesh) plus the look.
entity = {
	name = "lfg_nanite_planetcraft_mid_entity"
	pdxmesh = "war_planet_locators_mesh"
	cull_radius = 10000
	scale = 1

	locator = { name = "lfg_body" position = { 0 0 0 } }
	locator = { name = "lfg_north" position = { 0 250 0 } }
	locator = { name = "lfg_south" position = { 0 -250 0 } rotation = { 180 0 0 } }

	attach = { lfg_body = "lfg_nanite_planetcraft_body_entity" }
	attach = { lfg_body = "lfg_nanite_pc_interdictor_ring_entity" }
	attach = { lfg_body = "lfg_nanite_pc_swarmer_tilted_entity" }
	attach = { lfg_north = "lfg_nanite_pc_cap_entity" }
	attach = { lfg_south = "lfg_nanite_pc_cap_entity" }
	attach = { lfg_body = "lfg_nanite_swarm_planet_entity" }
}

# The planetcraft's hull model: an invisible frame at Gigastructural's scale (the sections hang on "root") that only
# explodes.
entity = {
	name = "lfg_nanite_planetcraft_entity"
	pdxmesh = "locator_mesh"
	cull_radius = 10000
	scale = @lfg_planetcraft_scale

	locator = { name = "root" position = { 0 0 0 } }
	locator = { name = "explosion_locator1" position = { 0 0 0 } }
	locator = { name = "explosion_locator2" position = { 180 80 120 } }
	locator = { name = "explosion_locator3" position = { -180 -80 -120 } }
	locator = { name = "explosion_locator4" position = { 0 200 -200 } }
	locator = { name = "explosion_locator5" position = { 0 -200 200 } }

	default_state = "idle"
	state = { name = "idle" state_time = 5 }
	state = { name = "moving" state_time = 5 }
	state = { name = "death" state_time = 5 looping = no
		event = { time = 0 node = "explosion_locator1" particle = "ship_explosion_particle" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 1 node = "explosion_locator2" particle = "ship_explosion_particle" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_large" } }
		event = { time = 2 node = "explosion_locator3" particle = "ship_explosion_particle" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 3 node = "explosion_locator4" particle = "ship_explosion_particle" trigger_once = yes keep_particle = yes sound = { soundeffect = "ship_destroyed_big_explosion" } }
		event = { time = 4 node = "explosion_locator5" particle = "juggernaut_explosion_particle" trigger_once = yes keep_particle = yes }
		event = { trigger_once = yes sound = { soundeffect = "amb_fallen_empire_titan_death" } }
	}

	game_data = {
		size = 150.0
		emissive_recolor_crunch = 50
	}
}
