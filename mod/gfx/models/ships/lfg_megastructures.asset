##### STAGES #####

# Stage 1 (lfg_progenitor_forge_1): the station ring in its cloud.
entity = {
	name = "lfg_progenitor_forge_stage_1_entity"
	cull_radius = 10000
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 0 0 0 } }
	attach = { "loc101" = "lfg_progenitor_forge_inner_ring_entity" }
	attach = { "loc101" = "lfg_progenitor_forge_cloud_ring_entity" }
	scale = @lfg_progenitor_forge_scale
}

# Finished forge (lfg_progenitor_forge_2): adds Gigastructural's assembly yards, tractor beams and the hive ring.
entity = {
	name = "lfg_progenitor_forge_complete_entity"
	cull_radius = 10000
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 0 0 0 } }
	attach = { "loc101" = "lfg_progenitor_forge_inner_ring_entity" }
	attach = { "loc101" = "lfg_progenitor_forge_cloud_ring_entity" }
	attach = { "loc101" = "giga_shipyard_yards_tilted_entity" }
	attach = { "loc101" = "giga_shipyard_tractor_ring_entity" }
	attach = { "loc101" = "lfg_progenitor_forge_outer_ring_entity" }
	scale = @lfg_progenitor_forge_scale
}

# Finished forge under construction: the yards and hive ring going up around stage 1.
entity = {
	name = "lfg_progenitor_forge_complete_construction_entity"
	cull_radius = 10000
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 0 0 0 } }
	attach = { "loc101" = "giga_shipyard_yards_tilted_entity" }
	attach = { "loc101" = "lfg_progenitor_forge_outer_ring_entity" }
	scale = @lfg_progenitor_forge_scale
}

##### SWARMFORGE (lfg_swarmforge_ready): a nanite cage over its star #####
# Six great circles of 12 Nanite Swarmers (vanilla's nanite cruiser) meeting at the poles, like a wireframe globe over
# the star; four nanite hive stations on the equator as the shipyard's docks; four grey goo clouds drifting through it.
# Under construction: three of the circles and the docks. Built like the Progenitor Forge's rings (pieces -> copies
# yawed around -> wrappers turned around the long axis). Sizes are first guesses: tune against an A / B star in game.
@lfg_swarmforge_scale = 1.5
@lfg_swarmforge_swarmer_scale = 3
@lfg_swarmforge_dock_scale = 2
@lfg_swarmforge_cloud_scale = 4

entity = {
	name = "lfg_swarmforge_swarmer_entity"
	cull_radius = 3000
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 0 0 0 } }
	attach = { "loc101" = "gatebuilder_01_cruiser_section_entity" }
	scale = @lfg_swarmforge_swarmer_scale
}

