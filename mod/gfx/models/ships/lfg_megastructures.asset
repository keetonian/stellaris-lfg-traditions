	locator = { name = "loc103" position = { 0 0 0 } rotation = { 0 60 0 } }
	locator = { name = "loc104" position = { 0 0 0 } rotation = { 0 90 0 } }
	locator = { name = "loc105" position = { 0 0 0 } rotation = { 0 120 0 } }
	locator = { name = "loc106" position = { 0 0 0 } rotation = { 0 150 0 } }
	attach = { "loc101" = "lfg_progenitor_forge_station_two_entity" }
	attach = { "loc102" = "lfg_progenitor_forge_station_two_entity" }
	attach = { "loc103" = "lfg_progenitor_forge_station_two_entity" }
	attach = { "loc104" = "lfg_progenitor_forge_station_two_entity" }
	attach = { "loc105" = "lfg_progenitor_forge_station_two_entity" }
	attach = { "loc106" = "lfg_progenitor_forge_station_two_entity" }
	scale = 1
}

entity = {
	name = "lfg_progenitor_forge_inner_ring_entity"
	cull_radius = 500
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 0 0 90 } }
	attach = { "loc101" = "lfg_progenitor_forge_station_six_entity" }
	scale = 1
}

