# LFG Traditions - megastructure models.

# Progenitor Forge (common/megastructures/lfg_megastructures.txt): built around its O-class star, like Gigastructural's
# Hyperstructural Assembly, whose rings this copies the layout of (giga_hyperstructual_ass.asset: two pieces -> six
# copies turned 30 degrees apart -> a wrapper turned { 0 0 90 }), so it sits the same way around the star. The nanite look:
#   - inner ring: 12 nanite (Gatebuilder) space stations, the stations of vanilla's nanite ships
#   - Gigastructural's assembly yards and tractor beams (the shipyard itself)
#   - outer ring: 12 nanite motherships (vanilla's Nanite Interdictor model)
#   - six grey goo clouds (vanilla's Grey Goo world particle) drifting on the outer ring
# Stage 1 is the inner ring and the clouds; the finished forge adds the yards, beams and outer ring.
# Sizes are first guesses: tune these against an O-class star in game.
@lfg_progenitor_forge_scale = 1.75
@lfg_progenitor_forge_station_scale = 3
@lfg_progenitor_forge_hive_scale = 2.5
@lfg_progenitor_forge_cloud_scale = 6

##### INNER RING: nanite stations #####

entity = {
	name = "lfg_progenitor_forge_station_two_entity"
	cull_radius = 500
	locator = { name = "loc101" position = { 0 0 -260 } rotation = { 0 0 0 } }
	locator = { name = "loc102" position = { 0 0 260 } rotation = { 0 180 0 } }
	attach = { "loc101" = "lfg_progenitor_forge_station_entity" }
	attach = { "loc102" = "lfg_progenitor_forge_station_entity" }
	scale = 1
}

entity = {
	name = "lfg_progenitor_forge_station_entity"
	cull_radius = 500
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 0 0 0 } }
	attach = { "loc101" = "gatebuilder_01_space_station_section_entity" }
	scale = @lfg_progenitor_forge_station_scale
}

entity = {
	name = "lfg_progenitor_forge_station_six_entity"
