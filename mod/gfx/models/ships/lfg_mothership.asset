# LFG Traditions - the Mothership's model (lfg_mothership, common/ship_sizes/lfg_ship_sizes.txt). Our own design from
# vanilla's nanite (Gatebuilder) ships, replacing Gigastructural's systemcraft look:
#   - core: a Swarm Core world (lfg_mothership_core_entity, generated in lfg_nanite_celestials.asset from Giga's
#     planetcraft mesh with the machine world skin)
#   - three gyroscope rings of 12 Nanite Interdictors each, tilted 60 degrees apart around the ship's long axis
#   - a nanite hive station as the prow and a larger one as the stern, set edge-on like shields
#   - a wide halo of 24 Nanite Swarmers
#   - the grey goo swarm cloud (lfg_nanite_swarm_mothership_entity) and Gigastructural's systemcraft thruster plumes
# Weapons still sit on Gigastructural's systemcraft weapon locators (war_system_locators_mesh, in every section), so they
# fire from around the same ~600 x 950 volume. The look is in the mid section (lfg_mothership_mid_entity) so the ship
# designer shows it. Ring layout as in lfg_megastructures.asset:
# two pieces -> copies yawed around -> a wrapper turned around the long (z) axis.
# Sizes are first guesses (meshes: interdictor ~77 long, swarmer ~27, hive station ~84 across): tune in game.

@lfg_ms_interdictor_scale = 2
@lfg_ms_swarmer_scale = 3
@lfg_ms_prow_scale = 2.5
@lfg_ms_stern_scale = 3

##### PIECES #####

entity = {
	name = "lfg_ms_interdictor_entity"
	cull_radius = 2000
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 0 0 0 } }
	attach = { "loc101" = "gatebuilder_01_mothership_section_entity" }
	scale = @lfg_ms_interdictor_scale
}

entity = {
	name = "lfg_ms_swarmer_entity"
	cull_radius = 2000
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 0 0 0 } }
	attach = { "loc101" = "gatebuilder_01_cruiser_section_entity" }
	scale = @lfg_ms_swarmer_scale
}

entity = {
	name = "lfg_ms_prow_entity"
	cull_radius = 2000
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 90 0 0 } }
	attach = { "loc101" = "gatebuilder_01_space_station_section_entity" }
	scale = @lfg_ms_prow_scale
}

entity = {
	name = "lfg_ms_stern_entity"
	cull_radius = 2000
	locator = { name = "loc101" position = { 0 0 0 } rotation = { 90 0 0 } }
	attach = { "loc101" = "gatebuilder_01_space_station_section_entity" }
	scale = @lfg_ms_stern_scale
}

