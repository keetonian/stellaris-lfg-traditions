##### THE SHIP #####

# Its mid section ("Nanite Hive Bays"): Gigastructural's systemcraft weapon locators plus the whole look, so the ship
# designer shows it.
entity = {
	name = "lfg_mothership_mid_entity"
	pdxmesh = "war_system_locators_mesh"
	cull_radius = 10000
	scale = 1

	locator = { name = "lfg_body" position = { 0 0 0 } }
	locator = { name = "lfg_prow" position = { 0 0 440 } }
	locator = { name = "lfg_stern" position = { 0 0 -480 } }

	attach = { lfg_body = "lfg_mothership_core_entity" }
	attach = { lfg_body = "lfg_ms_gyro_1_entity" }
	attach = { lfg_body = "lfg_ms_gyro_2_entity" }
	attach = { lfg_body = "lfg_ms_gyro_3_entity" }
	attach = { lfg_body = "lfg_ms_halo_ring_entity" }
	attach = { lfg_prow = "lfg_ms_prow_entity" }
	attach = { lfg_stern = "lfg_ms_stern_entity" }
	attach = { lfg_body = "lfg_nanite_swarm_mothership_entity" }
}

# The hull model: an invisible frame (the sections hang on "root") with the thruster plumes and explosions.

entity = {
	name = "lfg_mothership_entity"
	pdxmesh = "locator_mesh"
	cull_radius = 10000
	scale = 1

	locator = { name = "root" position = { 0 0 0 } }
	locator = { name = "thruster_center_1" position = { 0 0 -560 } rotation = { 0 180 0 } }
	locator = { name = "thruster_left_1" position = { -160 0 -520 } rotation = { 0 180 0 } }
	locator = { name = "thruster_right_1" position = { 160 0 -520 } rotation = { 0 180 0 } }
	locator = { name = "explosion_locator1" position = { 0 0 0 } }
	locator = { name = "explosion_locator2" position = { 250 60 200 } }
	locator = { name = "explosion_locator3" position = { -250 -60 -150 } }
	locator = { name = "explosion_locator4" position = { 0 200 -300 } }
	locator = { name = "explosion_locator5" position = { 0 -200 300 } }


	default_state = "idle"
	state = { name = "idle" state_time = 5
		event = { trigger_once = yes sound = { soundeffect = juggernaut_fungoid_idle } }
		event = { time = 0 node = "thruster_left_1" particle = "giga_systemcraft_small1_idle_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "thruster_right_1" particle = "giga_systemcraft_small1_idle_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "thruster_center_1" particle = "giga_systemcraft_large1_idle_particle" keep_particle = yes trigger_once = yes }
	}
	state = { name = "moving" state_time = 5
		event = { sound = { soundeffect = juggernaut_fungoid_move } }
		event = { time = 0 node = "thruster_left_1" particle = "giga_systemcraft_small1_moving_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "thruster_right_1" particle = "giga_systemcraft_small1_moving_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "thruster_center_1" particle = "giga_systemcraft_large1_moving_particle" keep_particle = yes trigger_once = yes }
	}
	state = { name = "death" state_time = 5 looping = no
		event = { time = 0 node = "explosion_locator1" particle = "ship_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 1 node = "explosion_locator2" particle = "ship_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_large" } }
		event = { time = 2 node = "explosion_locator3" particle = "ship_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 3 node = "explosion_locator4" particle = "ship_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_destroyed_big_explosion" } }
		event = { time = 4 node = "explosion_locator5" particle = "juggernaut_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "amb_fallen_empire_titan_death" } }
	}

	game_data = {
		size = 450.0
		emissive_recolor_crunch = 50
		trail_locators = {
			"thruster_center_1" =	{ width = 100 length = 150 height = 20 }
			"thruster_right_1" =	{ width = 100 length = 150 height = 20 }
			"thruster_left_1" =		{ width = 100 length = 150 height = 20 }
		}
	}
}
