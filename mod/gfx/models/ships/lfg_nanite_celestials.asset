# Nanite Armada hulls' look: Gigastructural's (3.40.4) moon / planetcraft entities with nanite planet
# textures and a grey goo swarm. Moon skins are picked through the hull sections; the planetcraft has one look.
@war_moon_scale = 0.8
@war_planet_scale = 0.33

# The swarm: vanilla's grey goo world cloud particle on a locator, attached to the hull's root node. Its size follows
